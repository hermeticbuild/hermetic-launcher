load(":toolchains_test.bzl", "prebuilt_toolchains_test_suite", "resolved_stubs")

package(default_testonly = True)

platform(
    name = "aarch64_windows",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:windows",
    ],
)

platform(
    name = "x86_64_windows",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
)

resolved_stubs(
    name = "resolved_stubs",
    tags = ["manual"],
)

prebuilt_toolchains_test_suite(
    name = "prebuilt_toolchains_test",
    platforms = {
        "aarch64_windows": ":aarch64_windows",
        "x86_64_windows": ":x86_64_windows",
    },
)
