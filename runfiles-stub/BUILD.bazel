load("//:defs.bzl", "rust_release_binary")

rust_release_binary(
    name = "runfiles-stub",
    srcs = glob(["src/*.rs"]),
    visibility = ["//visibility:public"],
    rustc_flags = ["-C", "panic=abort"] + select({
        "@platforms//os:linux": [
            "-Clink-arg=-nostartfiles",
            "-Clink-arg=-static",
            "-Clink-arg=-no-pie",
            "-Crelocation-model=static",
            "-Clink-arg=-lc",
            "-Clink-self-contained=no",
        ],
        # The macOS backend makes no libc calls (raw syscalls only, see
        # src/macos.rs), so there is no GOT and no __DATA_CONST to fold — the
        # linked image already carries no writable __DATA file page. We only need
        # to drop the dead Foundation dependency the toolchain injects.
        "@platforms//os:macos": [
            "-Clink-arg=-Wl,-dead_strip_dylibs",
        ],
        "//conditions:default": [],
    }),
)
