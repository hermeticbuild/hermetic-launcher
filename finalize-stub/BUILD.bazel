load("@rules_rust//rust:defs.bzl", "rust_test")
load("//:defs.bzl", "rust_release_binary")

rust_release_binary(
    name = "finalize-stub",
    srcs = glob(["src/*.rs"]),
    # The finalizer is panic = "unwind" (unlike the runfiles stub), so its unwind
    # tables are live; skip the optimizer, which would strip them.
    optimize = False,
    visibility = ["//visibility:public"],
    deps = [
        "@finalize_crates//:apple-codesign",
        "@finalize_crates//:clap",
    ],
)

rust_test(
    name = "template_test",
    srcs = ["src/template.rs"],
    crate_root = "src/template.rs",
    edition = "2021",
)
