load("@bazel_skylib//rules:native_binary.bzl", "native_test")
load("@hermetic_launcher//launcher:launcher_binary.bzl", "launcher_binary")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_go//go:def.bzl", "go_binary")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

cc_binary(
    name = "hello_cc",
    srcs = ["hello_cc.cc"],
)

go_binary(
    name = "hello_go",
    srcs = ["hello_go.go"],
    importpath = "example.com/hello_go",
)

py_binary(
    name = "hello_py",
    srcs = ["hello_py.py"],
)

sh_binary(
    name = "hello_sh",
    srcs = ["hello_sh.sh"],
)

# Chain: Go -> Python -> C++ -> Shell
# Single launcher_binary with Go as entrypoint, passing rlocationpaths
# for the rest of the chain as embedded args.
launcher_binary(
    name = "launch_chain",
    data = [
        ":hello_cc",
        ":hello_py",
        ":hello_sh",
    ],
    embedded_args = [
        "$(rlocationpath :hello_py)",
        "$(rlocationpath :hello_cc)",
        "$(rlocationpath :hello_sh)",
    ],
    entrypoint = ":hello_go",
)

native_test(
    name = "e2e_chain_test",
    src = ":launch_chain",
)
